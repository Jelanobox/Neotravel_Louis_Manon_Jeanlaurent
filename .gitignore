# ============================================================
# NeoTravel — .gitignore
# ============================================================

# Variables d'environnement (contiennent des secrets !)
.env
.env.local
.env.*.local
.env.production

# Next.js
frontend/.next/
frontend/out/
frontend/build/
frontend/node_modules/

# Node.js général
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# VS Code (optionnel — commenter si vous voulez partager vos settings)
# .vscode/

# Logs
*.log
logs/

# Exports temporaires
*.tmp
*.temp

# Exports PDF/docx générés localement (ne pas commiter les devis)
exports/
