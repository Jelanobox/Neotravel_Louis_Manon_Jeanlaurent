# ============================================================
# NeoTravel — Variables d'environnement
# Copier ce fichier en .env.local (jamais commité sur Git)
# ============================================================

# --- Frontend (Next.js) ---
# URL du webhook Chat Trigger n8n (visible dans n8n > workflow > Chat Trigger > Test URL)
# Format : https://manon59118.app.n8n.cloud/webhook/XXXXXXXX/chat
NEXT_PUBLIC_N8N_CHAT_WEBHOOK_URL=https://manon59118.app.n8n.cloud/webhook/255dd347-8ed8-4646-bf10-72116af566e0/chat

# --- n8n (à configurer dans les credentials n8n) ---

# Airtable
AIRTABLE_TOKEN=patXXXXXXXXXXXXXX
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# Resend (emails transactionnels)
RESEND_API_KEY=re_XXXXXXXXXXXXXXXX
RESEND_FROM_EMAIL=devis@neotravel.fr

# Brevo (alternative à Resend, si utilisé)
BREVO_API_KEY=xkeysib-XXXXXXXXXXXXXXXX

# OpenAI (LLM pour l'agent n8n)
OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXX
# Modèle recommandé : gpt-4o-mini (bon rapport qualité/coût)
OPENAI_MODEL=gpt-4o-mini

# --- Optionnel ---
# Google Maps API (pour calculer distance réelle entre villes)
GOOGLE_MAPS_API_KEY=AIzaXXXXXXXXXXXXXX

# URL du site en production (pour les liens dans les emails)
NEXT_PUBLIC_SITE_URL=https://neotravel.vercel.app
